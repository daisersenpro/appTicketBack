# Visual Studio / .NET common ignores
.vs/
*.user
*.suo
*.userosscache
*.userprefs

# Build results (ignore bin/obj in any project folder)
**/bin/
**/obj/
out/
artifacts/

# NuGet
*.nupkg
packages/
project.lock.json
project.fragment.lock.json

# Rider
.idea/

# VS Code
.vscode/

# Publish output
publish/
*.PublishItems.cache

# Logs
*.log
TestResults/

# Debug/Release files and symbols
*.dll
*.exe
*.app
*.appx
*.msi
*.pdb

# Local DB and cache
*.mdf
*.ldf
*.sqlite
*.db

# User secrets and local configuration (do not commit secrets or local overrides)
secrets.json
local.settings.json
appsettings.Development.json
appsettings.Local.json
appsettings.*.Local.json

# Coverage and test artifacts
coverage/
*.coverage
*.coveragexml

# Resharper
_ReSharper*/
*.DotSettings.user

# OS files
Thumbs.db
.DS_Store

# Node (if frontend parts exist)
node_modules/
dist/

# Tooling
.dotnet/tools/
.terraform/

# Ignore VS publish and temporary files
*.publishsettings
*.retry

# Ignore temporary NuGet files
.nuget/

# Keep lockfiles tracked by default (uncomment if you prefer to ignore them)
# package-lock.json
# yarn.lock

# GitHub generated temp files
.gitattributes
